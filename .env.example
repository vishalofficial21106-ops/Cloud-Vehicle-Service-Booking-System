# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas Cloud or Local MongoDB)
# Example Local: mongodb://127.0.0.1:27017/cloud_vehicle_service
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/cloud_vehicle_service?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/cloud_vehicle_service

# JWT Secret Key for Authentication
# Replace with your own secure random string
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
